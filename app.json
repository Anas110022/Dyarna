{
  "expo": {
    "name": "Dyarna",
    "slug": "dyarna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dyarna",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ديارنا بتستخدم موقعك لعرض العقارات القريبة منك على الخريطة."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2B21",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B2B21"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ديارنا بتستخدم موقعك لعرض العقارات القريبة منك على الخريطة."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
