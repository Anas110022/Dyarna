# Supabase project credentials (Settings > API in the Supabase dashboard).
# Copy this file to .env and fill in real values — .env is gitignored.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps iOS API key — from your existing Google Cloud project:
# console.cloud.google.com > APIs & Services > Credentials > your API key
# (or create one). Requires "Maps SDK for iOS" enabled on that project
# (APIs & Services > Library). Restrict the key to iOS apps with bundle ID
# com.anonymous.dyarna (Application restrictions) so it can't be used
# outside this app. Read only at config time (app.config.js) to set up
# native Google Maps on iOS — never bundled into client JS, no
# EXPO_PUBLIC_ prefix needed.
GOOGLE_MAPS_IOS_API_KEY=

# Auth setup notes (Supabase dashboard, not env vars):
# - Authentication > Sign In / Providers > Phone: enable phone provider + an
#   SMS gateway (see docs/dyarna-app-specs.md §7 re: Syria coverage) so
#   signInWithOtp({ phone }) can send the app's phone OTP screen a code.
# - Authentication > Emails > Confirm signup template: change it to send the
#   {{ .Token }} code (not the default {{ .ConfirmationURL }} magic link),
#   since email signup verifies through the in-app OTP screen, not a link.
